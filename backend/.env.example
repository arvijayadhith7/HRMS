# Backend
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/virtualnest?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="your-super-secret-access-token-key-min-10-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-min-10-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# External Services
RESEND_API_KEY="re_..."
CLOUDINARY_URL="cloudinary://..."

# Frontend
FRONTEND_URL="http://localhost:3000"
